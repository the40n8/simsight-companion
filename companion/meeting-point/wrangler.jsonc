// The phone app's meeting point (optional): deploy it to a Cloudflare
// account, then add its address on the SimSight setup page (meeting points).
// Guide: docs/mac/MEETING-POINT.md
{
  "name": "simsight",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  // The phone app itself, built by mac/build.sh (companion/web/build).
  "assets": {
    "directory": "../web/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the meeting point's own answers and the app's start page run code;
    // the app's other files are served directly (free, not counted).
    "run_worker_first": ["/mp/*", "/", "/index.html", "/manifest.json"]
  },
  "durable_objects": {
    "bindings": [{ "name": "REGISTRY", "class_name": "Registry" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Registry"] }]
}
